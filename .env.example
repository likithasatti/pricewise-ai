# ==========================================
# PriceWise AI - Environment Variables
# ==========================================

# Backend Server Configuration
PORT=8080
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (Default: SQLite local persistence)
DATABASE_PATH=pricewise.db

# Amazon Real-Time Data API (RapidAPI)
# Get your free key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-amazon-data
RAPIDAPI_KEY=
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
AMAZON_COUNTRY=IN

# Flipkart Real-Time Data API (ReefAPI or RapidAPI)
# Option 1: ReefAPI (https://api.reefapi.com)
REEFAPI_KEY=
REEFAPI_FLIPKART_URL=https://api.reefapi.com/flipkart/v1/search
# Option 2: RapidAPI Flipkart
FLIPKART_API_KEY=
FLIPKART_API_HOST=real-time-flipkart-data2.p.rapidapi.com

# Price Tracking Scheduler Configuration
# Interval in milliseconds (default: 60000 = 60s for development)
TRACKING_INTERVAL_MS=60000
TRACKING_ENABLED=true

# Optional AI / LLM Key for price trend analysis & generative buying advice
# Supports Google Gemini API (https://aistudio.google.com) or OpenAI
GEMINI_API_KEY=
AI_API_KEY=

# Firebase Configuration (Optional: for cloud production auth & Firestore)
# If unconfigured, backend runs in local mode with mock/local user authentication
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=pricewise-ai-be26e
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
